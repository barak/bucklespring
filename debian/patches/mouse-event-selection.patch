 main.c          | 83 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 scan-libinput.c | 25 +++++++++++++----
 scan-x11.c      | 40 ++++++++++++++++++++++++---
 4 files changed, 160 insertions(+), 8 deletions(-)

