[Unit]
Description=Nostalgia bucklespring keyboard sound (X11 flavour)
Documentation=man:buckle-x11.service(8) man:buckle-x11(1)
# Tie the service to the desktop session rather than to the user manager.
# Where the user has lingering enabled the user manager, and with it
# default.target, stays up from boot to shutdown, so a unit wanted by
# default.target would keep playing to an empty room.  graphical-session.target
# is started by the session at login and stopped at logout, on the local seat
# only, which is what we want here.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
# -f borrows a clip for any key the chosen set has nothing for.  Several of the
# sets cover only the keys someone sat down and recorded, and none of them
# covers the media keys, so without this a good deal of the keyboard is silent.
# The tray menu has the same switch, and "systemctl --user edit buckle-x11"
# takes it away for good.
ExecStart=@bindir@/buckle-x11 -f
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# ProtectSystem=strict makes everything read-only, the user's own runtime
# directory included, and GTK wants to write a dconf cache into it.  Without
# this the journal collects a hundred "dconf will not work properly" lines
# every time the service starts.  It is the user's own directory, so handing
# it back costs none of the protection that line is there for.
ReadWritePaths=%t
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=graphical-session.target
